:8080 {  
  @html {  
    path /index.html  
  }  
  header @html Cache-Control "no-cache, no-store, must-revalidate"  
  header @html Pragma "no-cache"  
  header @html Expires "0"  
  @static {  
    path /assets/*  
    path *.js  
    path *.css  
    path *.woff*  
    path *.ttf  
    path *.eot  
    path *.svg  
    path *.png  
    path *.jpg  
    path *.jpeg  
    path *.gif  
    path *.webp  
    path *.ico  
  }  
  header @static Cache-Control "public, max-age=31536000, immutable"  
  try_files {path} /index.html  
  file_server  
}  
